    }

    .note {
      margin: 14px 0 0;
      padding: 10px 12px;
      border-radius: 10px;
      background: #fff5d8;
      color: #604b08;
      font-size: 13px;
      line-height: 1.35;
    }

    .settings-toggle {
      position: fixed;
      top: 14px;
      left: 14px;
      z-index: 1100;
      min-width: 48px;
      height: 44px;
      padding: 0 12px;
      border: 0;
      border-radius: 12px;
      background: #172033;
