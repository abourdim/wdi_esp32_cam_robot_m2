    }

    .serial-send-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 7px;
      margin-top: 8px;
    }

    .serial-send-button {
      width: auto;
      min-width: 70px;
      margin-top: 0;
    }

    .serial-info {
      margin: 12px 0 0;
      padding-left: 19px;
