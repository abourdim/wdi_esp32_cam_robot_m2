      text-align: left;
    }

    .settings-sidebar.open {
      transform: translateX(0);
    }

    .settings-sidebar h2 {
      margin: 0 0 14px;
      font-size: 21px;
    }

    .settings-section {
      margin-top: 14px;
      padding: 14px;
      border: 1px solid #d7dce5;
      border-radius: 14px;
      background: white;
    }

    .settings-section h3 {
      margin: 0 0 12px;
      font-size: 16px;
    }

    .setting-row {
      margin-top: 12px;
    }

    .setting-row:first-of-type {
      margin-top: 0;
    }

    .setting-head {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 5px;
      font-size: 13px;
      font-weight: 700;
    }

    .setting-value {
      font-family: monospace;
      color: #475569;
    }

    .camera-select,
    .camera-range {
      width: 100%;
    }

    .camera-select {
      min-height: 42px;
      border: 1px solid #cbd5e1;
