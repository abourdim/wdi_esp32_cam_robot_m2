      background: #f8fafc;
      color: #172033;
      font-weight: 700;
      cursor: pointer;
    }

    .camera-status {
      margin-top: 10px;
      min-height: 42px;
      padding: 9px 10px;
      border-radius: 9px;
      background: #eef2f7;
      color: #475569;
      font-family: monospace;
      font-size: 12px;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .serial-web-status {
      margin-bottom: 10px;
      padding: 9px 10px;
      border-radius: 9px;
      background: #eef2f7;
      color: #475569;
      font-size: 12px;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .serial-web-status.ok {
      background: #dcfce7;
      color: #14532d;
    }

    .serial-web-status.error {
      background: #fee2e2;
      color: #7f1d1d;
    }

    .serial-toolbar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 7px;
    }

    .serial-inline-button {
      margin-top: 0;
    }

    .serial-port-info {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-top: 10px;
      padding: 8px 10px;
      border-radius: 9px;
      background: #eef2f7;
      font-size: 12px;
    }

    .serial-port-info span {
      color: #64748b;
    }

    .serial-port-info strong {
      max-width: 65%;
      font-family: monospace;
      text-align: right;
      overflow-wrap: anywhere;
    }

    .serial-capture-actions {
