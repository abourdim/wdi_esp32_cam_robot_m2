// Wi-Fi fallback configuration
// If the configured Wi-Fi cannot be reached within 10 seconds, the robot
// creates its own access point. Connect directly to it and open 192.168.4.1.
static const char *FALLBACK_AP_PASSWORD = "88888888";
static const uint32_t WIFI_CONNECT_TIMEOUT_MS = 10000;
static const uint32_t WIFI_RETRY_INTERVAL_MS = 30000;

// Browser OTA firmware update
// NOTE: The board must be flashed once by USB using an OTA-capable partition
// scheme (for example "Minimal SPIFFS (1.9MB APP with OTA/190KB SPIFFS)").
static const char *OTA_PASSWORD = "88888888";
volatile bool otaInProgress = false;

char fallbackApSsid[32] = "";
bool fallbackApActive = false;
unsigned long lastWiFiRetryMs = 0;
wl_status_t previousStaStatus = WL_IDLE_STATUS;

// Camera pins
#define PWDN_GPIO_NUM 32
#define RESET_GPIO_NUM -1
#define XCLK_GPIO_NUM 0
#define SIOD_GPIO_NUM 26
#define SIOC_GPIO_NUM 27

#define Y9_GPIO_NUM 35
#define Y8_GPIO_NUM 34
#define Y7_GPIO_NUM 39
#define Y6_GPIO_NUM 36
#define Y5_GPIO_NUM 21
#define Y4_GPIO_NUM 19
#define Y3_GPIO_NUM 18
#define Y2_GPIO_NUM 5
#define VSYNC_GPIO_NUM 25
#define HREF_GPIO_NUM 23
#define PCLK_GPIO_NUM 22

// TB6612FNG / SparkFun ROB-14450 motor driver pins, matching the schematic.
// PWMA and PWMB are physically tied together to GPIO12.
#define TB6612_PWM_AB_PIN 12
#define MOTOR_A_IN1_PIN 2
#define MOTOR_A_IN2_PIN 13
#define MOTOR_B_IN1_PIN 15
#define MOTOR_B_IN2_PIN 14

// Connector J6 / channel A = left motor; J7 / channel B = right motor.
#define MOTOR_L_IN1_PIN MOTOR_A_IN1_PIN
#define MOTOR_L_IN2_PIN MOTOR_A_IN2_PIN
#define MOTOR_R_IN1_PIN MOTOR_B_IN1_PIN
#define MOTOR_R_IN2_PIN MOTOR_B_IN2_PIN

// LED pin
#define LED_GPIO_NUM 4

// Flash LED brightness control
static const int LED_MIN_PWM = 0;
static const int LED_MAX_PWM = 255;
volatile int ledBrightness = 255;
volatile bool ledEnabled = false;

// UART0 / USB-TTL console pins
#define SERIAL_RX_PIN 3   // U0R
#define SERIAL_TX_PIN 1   // U0T
static const uint32_t SERIAL_BAUD = 115200;

// Camera orientation
bool Video_Flip = false;
bool cameraHasPsram = false;

// Motor control
// Full 8-bit PWM range is intentionally exposed for experimentation.
static const int MIN_PWM = 0;
static const int MAX_PWM = 255;
static const int START_KICK_MS = 120;  // brief boost when starting a motor from rest

volatile int leftMotorSpeed = 220;
volatile int rightMotorSpeed = 220;

int currentLeftPWM = 0;
int currentRightPWM = 0;

enum MotionState {
  MOTION_STOPPED,
  MOTION_FORWARD,
  MOTION_LEFT,
  MOTION_RIGHT
};

volatile MotionState motionState = MOTION_STOPPED;

// Browser debug/status panel
// Keep a short history on the ESP32 itself so quick button presses are not
// lost between browser polls.
#define DEBUG_EVENT_COUNT 64
#define DEBUG_EVENT_TEXT_LEN 80

struct DebugEvent {
  uint32_t id;
  uint32_t timeMs;
  char message[DEBUG_EVENT_TEXT_LEN];
};

char lastDebugMessage[128] = "Robot started";
DebugEvent debugEvents[DEBUG_EVENT_COUNT];
uint8_t debugEventHead = 0;   // next slot to write
uint8_t debugEventSize = 0;   // number of valid entries
uint32_t debugEventSequence = 0;
portMUX_TYPE debugMux = portMUX_INITIALIZER_UNLOCKED;

static const char *motionName(MotionState state) {
  switch (state) {
    case MOTION_FORWARD: return "FORWARD";
    case MOTION_LEFT:    return "LEFT";
    case MOTION_RIGHT:   return "RIGHT";
    case MOTION_STOPPED:
    default:             return "STOPPED";
  }
}

static void setDebugMessage(const char *message) {
  uint32_t now = millis();

  portENTER_CRITICAL(&debugMux);

  strncpy(lastDebugMessage, message, sizeof(lastDebugMessage) - 1);
  lastDebugMessage[sizeof(lastDebugMessage) - 1] = '\0';

  DebugEvent &event = debugEvents[debugEventHead];
  event.id = ++debugEventSequence;
  event.timeMs = now;
  strncpy(event.message, message, DEBUG_EVENT_TEXT_LEN - 1);
  event.message[DEBUG_EVENT_TEXT_LEN - 1] = '\0';

  debugEventHead = (debugEventHead + 1) % DEBUG_EVENT_COUNT;
  if (debugEventSize < DEBUG_EVENT_COUNT) {
    debugEventSize++;
  }

  portEXIT_CRITICAL(&debugMux);

  Serial.println(message);
}

static const char *networkModeName() {
  if (fallbackApActive) {
    if (WiFi.status() == WL_CONNECTED) return "AP+STA";
    return "AP";
  }

  if (WiFi.status() == WL_CONNECTED) return "STA";
  return "OFFLINE";
}

static const char *wifiStatusName(wl_status_t status) {
  switch (status) {
    case WL_IDLE_STATUS:
      return "idle / connecting";

    case WL_NO_SSID_AVAIL:
      return "SSID not found";

    case WL_SCAN_COMPLETED:
      return "scan completed";

    case WL_CONNECTED:
      return "connected";

    case WL_CONNECT_FAILED:
      return "connection/authentication failed";

    case WL_CONNECTION_LOST:
      return "connection lost";

    case WL_DISCONNECTED:
      return "disconnected";

    default:
      return "unknown";
  }
}

static void logWiFiStatus(const char *prefix, wl_status_t status) {
  char dbg[144];

  snprintf(
    dbg,
    sizeof(dbg),
    "%s: %s (code %d)",
    prefix,
    wifiStatusName(status),
    (int)status
  );

  setDebugMessage(dbg);
}

static void makeFallbackApName() {
  // Use the last 4 hex digits of the ESP32 eFuse MAC so multiple classroom
  // robots get distinct SSIDs, for example ESP32-Robot-F8B4.
  uint64_t chipId = ESP.getEfuseMac();
  uint16_t suffix = (uint16_t)(chipId & 0xFFFF);

  snprintf(
    fallbackApSsid,
    sizeof(fallbackApSsid),
    "ESP32-Robot-%04X",
    suffix
  );
}

static bool startFallbackAccessPoint() {
  makeFallbackApName();

  // AP+STA keeps the robot directly reachable while the station interface
  // continues trying to reach the configured school/home Wi-Fi.
  WiFi.mode(WIFI_AP_STA);

  bool ok = WiFi.softAP(fallbackApSsid, FALLBACK_AP_PASSWORD);
  fallbackApActive = ok;

  if (!ok) {
    setDebugMessage("ERROR: Could not start fallback access point");
    return false;
  }

  char dbg[128];

  snprintf(
    dbg,
    sizeof(dbg),
    "BOOT: Fallback AP started; SSID %s",
    fallbackApSsid
  );
  setDebugMessage(dbg);

  IPAddress apIp = WiFi.softAPIP();
  snprintf(
    dbg,
    sizeof(dbg),
    "BOOT: Fallback AP IP %u.%u.%u.%u",
    apIp[0], apIp[1], apIp[2], apIp[3]
  );
  setDebugMessage(dbg);

  // Re-start the station attempt after switching to AP+STA mode.
  WiFi.begin(ssid, password);
  lastWiFiRetryMs = millis();

  return true;
}

static void serviceWiFiFallback() {
  if (!fallbackApActive) return;

  wl_status_t currentStatus = WiFi.status();

  // Log only state changes so the event history remains readable.
  if (currentStatus != previousStaStatus) {
    if (currentStatus == WL_CONNECTED) {
      IPAddress ip = WiFi.localIP();
      char dbg[144];

      snprintf(
        dbg,
        sizeof(dbg),
        "NET: Configured Wi-Fi connected; IP %u.%u.%u.%u; fallback AP remains available",
        ip[0], ip[1], ip[2], ip[3]
      );
      setDebugMessage(dbg);
    } else {
      if (previousStaStatus == WL_CONNECTED) {
        setDebugMessage(
          "NET: Configured Wi-Fi connection lost; fallback AP remains available"
        );
      }

      logWiFiStatus("NET: Station status", currentStatus);
    }

    previousStaStatus = currentStatus;
  }

  // Periodically retry the configured Wi-Fi while preserving the AP.
  if (currentStatus != WL_CONNECTED &&
      millis() - lastWiFiRetryMs >= WIFI_RETRY_INTERVAL_MS) {
    lastWiFiRetryMs = millis();

    char dbg[160];
    snprintf(
      dbg,
      sizeof(dbg),
      "NET: Retrying configured Wi-Fi; previous status: %s",
      wifiStatusName(currentStatus)
    );
    setDebugMessage(dbg);

    WiFi.reconnect();
  }
}

#define PART_BOUNDARY "123456789000000000000987654321"
static const char *_STREAM_CONTENT_TYPE =
    "multipart/x-mixed-replace;boundary=" PART_BOUNDARY;
static const char *_STREAM_BOUNDARY = "\r\n--" PART_BOUNDARY "\r\n";
static const char *_STREAM_PART =
    "Content-Type: image/jpeg\r\nContent-Length: %u\r\n\r\n";

httpd_handle_t camera_httpd = NULL;
httpd_handle_t stream_httpd = NULL;

void startCameraServer();

static int clampMotorPWM(int value) {
  if (value < MIN_PWM) return MIN_PWM;
  if (value > MAX_PWM) return MAX_PWM;
  return value;
}

static int clampLedPWM(int value) {
  if (value < LED_MIN_PWM) return LED_MIN_PWM;
  if (value > LED_MAX_PWM) return LED_MAX_PWM;
  return value;
}

static void applyLedOutput() {
  int output = ledEnabled ? clampLedPWM(ledBrightness) : 0;
  analogWrite(LED_GPIO_NUM, output);
}

static void writeTb6612Forward(int in1Pin, int in2Pin, int pwm) {
  pwm = clampMotorPWM(pwm);

  // PWMA/PWMB are held HIGH globally. Drive forward by keeping IN2 LOW
  // and applying PWM to IN1, which preserves independent motor speeds.
  digitalWrite(in2Pin, LOW);
  analogWrite(in1Pin, pwm);
}

static void writeMotors(int leftPWM, int rightPWM) {
  leftPWM = clampMotorPWM(leftPWM);
  rightPWM = clampMotorPWM(rightPWM);

  // A motor that starts from zero gets a short full-power kick.
  // The exact requested PWM (0..255) is applied immediately afterward.
  bool kickLeft = (currentLeftPWM == 0 && leftPWM > 0);
  bool kickRight = (currentRightPWM == 0 && rightPWM > 0);

  if (kickLeft || kickRight) {
    writeTb6612Forward(MOTOR_L_IN1_PIN, MOTOR_L_IN2_PIN,
                       kickLeft ? MAX_PWM : leftPWM);
    writeTb6612Forward(MOTOR_R_IN1_PIN, MOTOR_R_IN2_PIN,
                       kickRight ? MAX_PWM : rightPWM);
    delay(START_KICK_MS);
  }

  writeTb6612Forward(MOTOR_L_IN1_PIN, MOTOR_L_IN2_PIN, leftPWM);
  writeTb6612Forward(MOTOR_R_IN1_PIN, MOTOR_R_IN2_PIN, rightPWM);

  currentLeftPWM = leftPWM;
  currentRightPWM = rightPWM;
}

static void stopMotors() {
  // TB6612 stop state: both direction inputs LOW. Shared PWMA/PWMB remains HIGH.
  analogWrite(MOTOR_L_IN1_PIN, 0);
  digitalWrite(MOTOR_L_IN2_PIN, LOW);
  analogWrite(MOTOR_R_IN1_PIN, 0);
  digitalWrite(MOTOR_R_IN2_PIN, LOW);
  currentLeftPWM = 0;
  currentRightPWM = 0;
}

static void applyMotion() {
  int leftNow = leftMotorSpeed;
  int rightNow = rightMotorSpeed;

  switch (motionState) {
    case MOTION_FORWARD:
      writeMotors(leftNow, rightNow);
      break;

    case MOTION_LEFT:
      writeMotors(0, rightNow);
      break;

    case MOTION_RIGHT:
      writeMotors(leftNow, 0);
      break;

    case MOTION_STOPPED:
    default:
      stopMotors();
      break;
  }
}

static void moveForward() {
  motionState = MOTION_FORWARD;
  applyMotion();
}

static void turnLeft() {
  motionState = MOTION_LEFT;
  applyMotion();
}

static void turnRight() {
  motionState = MOTION_RIGHT;
  applyMotion();
}

static void commandStop() {
  motionState = MOTION_STOPPED;
  stopMotors();
}

static const char *frameSizeName(framesize_t frameSize) {
  switch (frameSize) {
    case FRAMESIZE_QQVGA: return "QQVGA";
    case FRAMESIZE_QVGA:  return "QVGA";
    case FRAMESIZE_VGA:   return "VGA";
    case FRAMESIZE_SVGA:  return "SVGA";
    case FRAMESIZE_XGA:   return "XGA";
    case FRAMESIZE_SXGA:  return "SXGA";
    case FRAMESIZE_UXGA:  return "UXGA";
    default:               return "UNKNOWN";
  }
}

static bool parseFrameSize(const char *name, framesize_t *frameSize) {
  if (!name || !frameSize) return false;

  if (strcmp(name, "QQVGA") == 0) {
    *frameSize = FRAMESIZE_QQVGA;
  } else if (strcmp(name, "QVGA") == 0) {
    *frameSize = FRAMESIZE_QVGA;
  } else if (strcmp(name, "VGA") == 0) {
    *frameSize = FRAMESIZE_VGA;
  } else if (strcmp(name, "SVGA") == 0) {
    *frameSize = FRAMESIZE_SVGA;
  } else if (strcmp(name, "XGA") == 0) {
    *frameSize = FRAMESIZE_XGA;
  } else if (strcmp(name, "SXGA") == 0) {
    *frameSize = FRAMESIZE_SXGA;
  } else if (strcmp(name, "UXGA") == 0) {
    *frameSize = FRAMESIZE_UXGA;
  } else {
    return false;
  }

  return true;
}

static bool frameSizeNeedsPsram(framesize_t frameSize) {
  return frameSize == FRAMESIZE_SVGA ||
         frameSize == FRAMESIZE_XGA ||
         frameSize == FRAMESIZE_SXGA ||
         frameSize == FRAMESIZE_UXGA;
}

static void printSerialCameraStatus() {
  sensor_t *sensor = esp_camera_sensor_get();

  if (!sensor) {
    Serial.println("[CAMERA] Sensor unavailable");
    return;
  }

  Serial.println("[CAMERA]");
  Serial.printf("  resolution : %s\n", frameSizeName(sensor->status.framesize));
  Serial.printf("  quality    : %u (lower = better JPEG quality)\n",
                (unsigned int)sensor->status.quality);
  Serial.printf("  brightness : %d\n", (int)sensor->status.brightness);
  Serial.printf("  contrast   : %d\n", (int)sensor->status.contrast);
  Serial.printf("  saturation : %d\n", (int)sensor->status.saturation);
  Serial.printf("  vflip      : %u\n", (unsigned int)sensor->status.vflip);
  Serial.printf("  hmirror    : %u\n", (unsigned int)sensor->status.hmirror);
  Serial.printf("  PSRAM      : %s\n", cameraHasPsram ? "yes" : "no");
}

static void printSerialRobotStatus() {
  Serial.println("[STATUS]");
  Serial.printf("  motion       : %s\n", motionName(motionState));
  Serial.printf("  left target  : %d / 255\n", leftMotorSpeed);
  Serial.printf("  right target : %d / 255\n", rightMotorSpeed);
  Serial.printf("  left output  : %d / 255\n", currentLeftPWM);
  Serial.printf("  right output : %d / 255\n", currentRightPWM);
  Serial.printf("  flash LED    : %s, brightness %d / 255\n",
                ledEnabled ? "ON" : "OFF",
                ledBrightness);
  Serial.printf("  network mode : %s\n", networkModeName());
  Serial.printf("  STA status   : %s\n", wifiStatusName(WiFi.status()));

  if (WiFi.status() == WL_CONNECTED) {
    IPAddress ip = WiFi.localIP();
    Serial.printf(
      "  STA IP       : %u.%u.%u.%u\n",
      ip[0], ip[1], ip[2], ip[3]
    );
    Serial.printf("  RSSI         : %ld dBm\n", (long)WiFi.RSSI());
  }

  if (fallbackApActive) {
    IPAddress apIp = WiFi.softAPIP();
    Serial.printf("  AP SSID      : %s\n", fallbackApSsid);
    Serial.printf(
      "  AP IP        : %u.%u.%u.%u\n",
      apIp[0], apIp[1], apIp[2], apIp[3]
    );
    Serial.printf(
      "  AP clients   : %u\n",
      (unsigned int)WiFi.softAPgetStationNum()
    );
  }

  Serial.printf("  uptime       : %lu ms\n", (unsigned long)millis());
}

static void printSerialDebugHistory() {
  uint8_t sizeCopy;
  uint8_t headCopy;

  portENTER_CRITICAL(&debugMux);
  sizeCopy = debugEventSize;
  headCopy = debugEventHead;
  portEXIT_CRITICAL(&debugMux);

  uint8_t oldest =
    (headCopy + DEBUG_EVENT_COUNT - sizeCopy) % DEBUG_EVENT_COUNT;

  Serial.printf("[LOG] %u retained event(s)\n", (unsigned int)sizeCopy);

  for (uint8_t i = 0; i < sizeCopy; i++) {
    uint8_t index = (oldest + i) % DEBUG_EVENT_COUNT;
    DebugEvent eventCopy;

    portENTER_CRITICAL(&debugMux);
    eventCopy = debugEvents[index];
    portEXIT_CRITICAL(&debugMux);

    Serial.printf(
      "  [%lu ms] #%lu %s\n",
      (unsigned long)eventCopy.timeMs,
      (unsigned long)eventCopy.id,
      eventCopy.message
    );
  }
}

static void printSerialHelp() {
  Serial.println();
  Serial.println("ESP32-CAM Robot UART0 Console");
  Serial.printf("UART0: %lu baud 8N1, RX=GPIO%d(U0R), TX=GPIO%d(U0T)\n",
                (unsigned long)SERIAL_BAUD,
                SERIAL_RX_PIN,
                SERIAL_TX_PIN);
  Serial.println("Commands:");
  Serial.println("  help    - show this command list");
  Serial.println("  status  - robot/motor/network status");
  Serial.println("  log     - dump retained debug event history");
  Serial.println("  camera  - current camera settings");
  Serial.println("  stop    - emergency motor stop");
  Serial.println();
}

static char serialCommandBuffer[96];
static size_t serialCommandLength = 0;

static void handleSerialCommand(char *command) {
  if (!command) return;

  while (*command == ' ' || *command == '\t') command++;

  for (char *p = command; *p; ++p) {
    if (*p >= 'A' && *p <= 'Z') {
      *p = (char)(*p - 'A' + 'a');
    }
  }

  if (strcmp(command, "") == 0) {
    return;
  }

  if (strcmp(command, "help") == 0 || strcmp(command, "?") == 0) {
    printSerialHelp();
  } else if (strcmp(command, "status") == 0) {
    printSerialRobotStatus();
  } else if (strcmp(command, "log") == 0) {
    printSerialDebugHistory();
  } else if (strcmp(command, "camera") == 0) {
    printSerialCameraStatus();
  } else if (strcmp(command, "stop") == 0) {
    commandStop();
    setDebugMessage("SERIAL: Emergency STOP");
  } else {
    Serial.printf(
      "Unknown command: %s. Type 'help'.\n",
      command
    );
  }
}

static void serviceSerialConsole() {
  while (Serial.available() > 0) {
    char c = (char)Serial.read();

    if (c == '\r' || c == '\n') {
      if (serialCommandLength > 0) {
        serialCommandBuffer[serialCommandLength] = '\0';
        handleSerialCommand(serialCommandBuffer);
        serialCommandLength = 0;
      }
      continue;
    }

    if (c == 8 || c == 127) {
      if (serialCommandLength > 0) {
        serialCommandLength--;
      }
      continue;
    }

    if (c >= 32 && c <= 126 &&
        serialCommandLength < sizeof(serialCommandBuffer) - 1) {
      serialCommandBuffer[serialCommandLength++] = c;
    }
  }
}

void setup() {
  WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0);

  pinMode(TB6612_PWM_AB_PIN, OUTPUT);
  pinMode(MOTOR_L_IN1_PIN, OUTPUT);
  pinMode(MOTOR_L_IN2_PIN, OUTPUT);
  pinMode(MOTOR_R_IN1_PIN, OUTPUT);
  pinMode(MOTOR_R_IN2_PIN, OUTPUT);
  pinMode(LED_GPIO_NUM, OUTPUT);

  // The schematic ties PWMA and PWMB to GPIO12 and STBY directly to +5V.
  // Keep both bridge channels enabled and generate per-motor PWM on IN1.
  digitalWrite(TB6612_PWM_AB_PIN, HIGH);

  stopMotors();
  ledEnabled = false;
  ledBrightness = 255;
  applyLedOutput();

  Serial.begin(SERIAL_BAUD, SERIAL_8N1, SERIAL_RX_PIN, SERIAL_TX_PIN);
  Serial.setDebugOutput(false);
  delay(50);
  printSerialHelp();

  // Startup events are stored in the same Wi-Fi debug history as runtime events.
  setDebugMessage("BOOT: ESP32-CAM startup");
  setDebugMessage("BOOT: UI features = motor sync, UART console, camera settings");
  setDebugMessage("BOOT: Motor outputs initialized and stopped");
  setDebugMessage("BOOT: Flash LED initialized OFF; brightness 255 / 255");

  // Camera configuration
  setDebugMessage("BOOT: Configuring camera");
  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;
  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;
  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;

  cameraHasPsram = psramFound();

  if (cameraHasPsram) {
    config.frame_size = FRAMESIZE_VGA;
    config.jpeg_quality = 10;
    config.fb_count = 2;
    setDebugMessage("BOOT: PSRAM detected; camera VGA / 2 frame buffers");
  } else {
    config.frame_size = FRAMESIZE_HVGA;
    config.jpeg_quality = 12;
    config.fb_count = 1;
    setDebugMessage("BOOT: No PSRAM; camera HVGA / 1 frame buffer");
  }

  setDebugMessage("BOOT: Initializing camera");
  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    char dbg[96];
    snprintf(dbg, sizeof(dbg), "ERROR: Camera init failed: 0x%x", err);
    setDebugMessage(dbg);
    return;
  }

  setDebugMessage("BOOT: Camera initialized OK");

  if (Video_Flip) {
    sensor_t *s = esp_camera_sensor_get();
    s->set_vflip(s, 1);
    s->set_hmirror(s, 0);
    setDebugMessage("BOOT: Camera vertical flip enabled");
  } else {
    setDebugMessage("BOOT: Camera orientation normal");
  }

  setDebugMessage("BOOT: Connecting to configured Wi-Fi");
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  unsigned long wifiStart = millis();

  while (WiFi.status() != WL_CONNECTED &&
         millis() - wifiStart < WIFI_CONNECT_TIMEOUT_MS) {
    delay(250);
    Serial.print(".");
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    char wifiDbg[128];
    IPAddress ip = WiFi.localIP();

    snprintf(
      wifiDbg,
      sizeof(wifiDbg),
      "BOOT: Wi-Fi connected; IP %u.%u.%u.%u",
      ip[0], ip[1], ip[2], ip[3]
    );
    setDebugMessage(wifiDbg);

    snprintf(
      wifiDbg,
      sizeof(wifiDbg),
      "BOOT: Wi-Fi RSSI %ld dBm",
      (long)WiFi.RSSI()
    );
    setDebugMessage(wifiDbg);

    Serial.print("Robot Ready! Open: http://");
    Serial.println(ip);

    previousStaStatus = WL_CONNECTED;
  } else {
    wl_status_t failedStatus = WiFi.status();

    char wifiDbg[160];
    snprintf(
      wifiDbg,
      sizeof(wifiDbg),
      "BOOT: Wi-Fi timeout after 10 seconds; status: %s (code %d)",
      wifiStatusName(failedStatus),
      (int)failedStatus
    );
    setDebugMessage(wifiDbg);

    if (failedStatus == WL_NO_SSID_AVAIL) {
      setDebugMessage("BOOT: Configured Wi-Fi SSID was not found");
    } else if (failedStatus == WL_CONNECT_FAILED) {
      setDebugMessage(
        "BOOT: Wi-Fi connection/authentication failed; check password and security settings"
      );
    } else if (failedStatus == WL_CONNECTION_LOST) {
      setDebugMessage("BOOT: Wi-Fi connection was lost before startup completed");
    } else if (failedStatus == WL_DISCONNECTED) {
      setDebugMessage(
        "BOOT: Wi-Fi remained disconnected; SSID, password, signal, or AP compatibility may be the cause"
      );
    }

    setDebugMessage("BOOT: Starting fallback access point");

    if (startFallbackAccessPoint()) {
      IPAddress apIp = WiFi.softAPIP();

      Serial.println();
      Serial.println("Configured Wi-Fi unavailable.");
      Serial.print("Fallback SSID: ");
      Serial.println(fallbackApSsid);
      Serial.println("Fallback password: 88888888");
      Serial.print("Open: http://");
      Serial.println(apIp);
    }

    previousStaStatus = WiFi.status();
  }

  setDebugMessage("BOOT: Starting HTTP and camera-stream servers");
  startCameraServer();
  setDebugMessage("BOOT: Robot web server ready");
}

void loop() {
  serviceSerialConsole();

  if (!otaInProgress) {
    serviceWiFiFallback();
  }

  delay(10);
}

static const char PROGMEM INDEX_HTML[] = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
  <title>ESP32-CAM Robot</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta charset="UTF-8"/>
  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">

  <style>
    * { box-sizing: border-box; }

    body {
      font-family: Arial, sans-serif;
      text-align: center;
      margin: 0;
      padding: 18px 12px 35px;
      background: #f7f8fa;
      color: #172033;
    }

    h1 {
      margin: 0 0 12px;
      font-size: clamp(25px, 5vw, 38px);
    }

    .robot {
      width: min(620px, 100%);
      margin: 0 auto;
    }

    .video-frame {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border: 2px solid #2f4468;
      border-radius: 12px;
      background: #111;
      transition: aspect-ratio 0.18s ease;
    }

    #photo {
      position: absolute;
      top: 50%;
      left: 50%;
      display: block;
      max-width: none;
      max-height: none;
      transform-origin: center center;
      background: #111;
    }

    .panel {
      width: min(390px, 100%);
      margin: 16px auto 0;
      padding: 16px;
      background: white;
      border: 1px solid #d7dce5;
      border-radius: 16px;
    }

    .speed-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 8px;
      font-weight: 700;
    }

    .speed-value {
      color: #2f4468;
      white-space: nowrap;
    }

    .motor-control {
      padding: 10px 0;
    }

    .motor-control + .motor-control {
      border-top: 1px solid #e4e7ec;
      margin-top: 8px;
    }

    .motor-slider {
      width: 100%;
      min-width: 0;
      accent-color: #2f4468;
      cursor: pointer;
    }

    .motor-adjust {
      display: grid;
      grid-template-columns: 50px minmax(0, 1fr) 50px;
      align-items: center;
      gap: 8px;
    }

    .pwm-step {
      min-height: 42px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      background: #f8fafc;
      color: #172033;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
    }

    .ui-version {
      margin-bottom: 10px;
      color: #667085;
      font-size: 11px;
      text-align: center;
      letter-spacing: 0.02em;
    }

    .sync-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 8px;
      padding: 10px 0 12px;
      border-bottom: 1px solid #e4e7ec;
    }

    .sync-control {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      cursor: pointer;
    }

    .sync-control input {
      width: 20px;
      height: 20px;
      accent-color: #2f4468;
    }

    .sync-note {
      color: #667085;
      font-size: 12px;
      text-align: right;
    }

    .speed-scale {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: #667085;
      margin-top: 3px;
    }

    .button-container {
      display: grid;
      grid-template-columns: repeat(3, 82px);
      grid-template-areas:
        ". forward led"
        "left stop right"
        ". backward .";
      gap: 10px;
      justify-content: center;
      margin-top: 18px;
    }

    button {
      touch-action: manipulation;
      user-select: none;
      -webkit-user-select: none;
    }

    .button, .led-button {
      border: 0;
      color: white;
      font-size: 22px;
      width: 82px;
      height: 58px;
      border-radius: 13px;
      cursor: pointer;
      background: #2f4468;
    }

    .button:active {
      transform: scale(0.97);
    }

    .forward { grid-area: forward; }
    .left { grid-area: left; }
    .stop { grid-area: stop; }
    .right { grid-area: right; }
    .backward { grid-area: backward; }
    .led { grid-area: led; }

    .stop {
      background: #9b2c2c;
    }

    .led-button {
      font-size: 16px;
      background: #777;
    }

    .led-on {
      background: #e9b900;
