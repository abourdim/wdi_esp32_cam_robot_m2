      font-size: 13px;
      line-height: 1.55;
    }

    .serial-commands {
      margin-top: 10px;
      padding: 9px 10px;
      border-radius: 9px;
      background: #111827;
      color: #e5e7eb;
      font-family: monospace;
      font-size: 12px;
      line-height: 1.5;
    }

    .debug-toggle {
      position: fixed;
      top: 14px;
      right: 14px;
      z-index: 1100;
      min-width: 48px;
      height: 44px;
      padding: 0 12px;
      border: 0;
      border-radius: 12px;
      background: #172033;
      color: white;
      font-size: 20px;
      cursor: pointer;
    }

    .debug-sidebar {
      position: fixed;
      top: 0;
      right: 0;
      z-index: 1050;
      width: min(340px, 88vw);
      height: 100vh;
      padding: 72px 16px 18px;
      background: #111827;
      color: #f9fafb;
