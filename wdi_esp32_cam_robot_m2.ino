// Browser debug/status panel
// Keep a short history on the ESP32 itself so quick button presses are not
// lost between browser polls.
#define DEBUG_EVENT_COUNT 64
#define DEBUG_EVENT_TEXT_LEN 80

struct DebugEvent {
  uint32_t id;
  uint32_t timeMs;
  char message[DEBUG_EVENT_TEXT_LEN];
};

char lastDebugMessage[128] = "Robot started";
DebugEvent debugEvents[DEBUG_EVENT_COUNT];
uint8_t debugEventHead = 0;   // next slot to write
uint8_t debugEventSize = 0;   // number of valid entries
uint32_t debugEventSequence = 0;
portMUX_TYPE debugMux = portMUX_INITIALIZER_UNLOCKED;

static const char *motionName(MotionState state) {
  switch (state) {
    case MOTION_FORWARD: return "FORWARD";
    case MOTION_BACKWARD: return "BACKWARD";
    case MOTION_LEFT:    return "LEFT";
    case MOTION_RIGHT:   return "RIGHT";
    case MOTION_STOPPED:
    default:             return "STOPPED";
  }
}

static void setDebugMessage(const char *message) {
  uint32_t now = millis();

  portENTER_CRITICAL(&debugMux);

  strncpy(lastDebugMessage, message, sizeof(lastDebugMessage) - 1);
  lastDebugMessage[sizeof(lastDebugMessage) - 1] = '\0';

  DebugEvent &event = debugEvents[debugEventHead];
  event.id = ++debugEventSequence;
  event.timeMs = now;
  strncpy(event.message, message, DEBUG_EVENT_TEXT_LEN - 1);
  event.message[DEBUG_EVENT_TEXT_LEN - 1] = '\0';

  debugEventHead = (debugEventHead + 1) % DEBUG_EVENT_COUNT;
  if (debugEventSize < DEBUG_EVENT_COUNT) {
    debugEventSize++;
  }

  portEXIT_CRITICAL(&debugMux);

  Serial.println(message);
}

static const char *networkModeName() {
  if (fallbackApActive) {
    if (WiFi.status() == WL_CONNECTED) return "AP+STA";
    return "AP";
  }

  if (WiFi.status() == WL_CONNECTED) return "STA";
  return "OFFLINE";
}

static const char *wifiStatusName(wl_status_t status) {
  switch (status) {
    case WL_IDLE_STATUS:
      return "idle / connecting";

    case WL_NO_SSID_AVAIL:
      return "SSID not found";

    case WL_SCAN_COMPLETED:
      return "scan completed";

    case WL_CONNECTED:
      return "connected";

    case WL_CONNECT_FAILED:
      return "connection/authentication failed";

    case WL_CONNECTION_LOST:
      return "connection lost";

    case WL_DISCONNECTED:
      return "disconnected";

    default:
      return "unknown";
  }
}

static void logWiFiStatus(const char *prefix, wl_status_t status) {
  char dbg[144];

  snprintf(
    dbg,
    sizeof(dbg),
    "%s: %s (code %d)",
    prefix,
    wifiStatusName(status),
    (int)status
  );

  setDebugMessage(dbg);
}

static void makeFallbackApName() {
  // Use the last 4 hex digits of the ESP32 eFuse MAC so multiple classroom
  // robots get distinct SSIDs, for example ESP32-Robot-57AC.
  //
  // ESP.getEfuseMac() packs the six MAC bytes little-endian, so mac[0] -- the
  // first byte of the vendor OUI -- lands in the LOW bits of the value.
  // Masking 0xFFFF therefore named the board after Espressif rather than
  // after itself: every ESP32-CAM sharing an OUI came up as the same
  // ESP32-Robot-AA8C, which is precisely the collision this is meant to
  // avoid. The half of the address that is unique per board is at the top.
  uint64_t chipId = ESP.getEfuseMac();
  uint8_t macByte4 = (uint8_t)((chipId >> 32) & 0xFF);
  uint8_t macByte5 = (uint8_t)((chipId >> 40) & 0xFF);

  snprintf(
    fallbackApSsid,
    sizeof(fallbackApSsid),
    "ESP32-Robot-%02X%02X",
    macByte4,
    macByte5
  );
}

static bool startFallbackAccessPoint() {
  makeFallbackApName();

  // Stop the timed-out STA association before enabling the fallback AP.  A
  // still-running Wi-Fi scan/association can keep moving the shared radio
  // between channels and make the AP answer ICMP while TCP connections time
  // out.  Keep AP+STA capability enabled, but leave STA idle until the retry
  // service decides it is safe to try again.
  WiFi.disconnect(false, false);
  delay(100);

  WiFi.mode(WIFI_AP_STA);
  // Changing mode resets the power-save setting, so re-apply it here too.
  WiFi.setSleep(false);

  bool ok = WiFi.softAP(fallbackApSsid, FALLBACK_AP_PASSWORD);
  fallbackApActive = ok;

  if (!ok) {
    setDebugMessage("ERROR: Could not start fallback access point");
    return false;
  }

  char dbg[128];

  snprintf(
    dbg,
    sizeof(dbg),
    "BOOT: Fallback AP started; SSID %s from base MAC %s",
    fallbackApSsid,
    WiFi.macAddress().c_str()
  );
  setDebugMessage(dbg);

  IPAddress apIp = WiFi.softAPIP();
  snprintf(
    dbg,
    sizeof(dbg),
    "BOOT: Fallback AP IP %u.%u.%u.%u",
    apIp[0], apIp[1], apIp[2], apIp[3]
  );
  setDebugMessage(dbg);

  // Do not call WiFi.begin() here.  The initial attempt has just timed out and
  // immediately starting a second association is exactly when users connect
  // to 192.168.4.1.  serviceWiFiFallback() will retry later, and pauses those
  // retries whenever an AP client is present.
  lastWiFiRetryMs = millis();
  wifiRetryIntervalMs = WIFI_RETRY_INTERVAL_MS;
  wifiRetryPaused = false;

  return true;
}

static void serviceWiFiFallback() {
  if (!fallbackApActive) return;

  wl_status_t currentStatus = WiFi.status();

  // Log only state changes so the event history remains readable.
  if (currentStatus != previousStaStatus) {
    if (currentStatus == WL_CONNECTED) {
      IPAddress ip = WiFi.localIP();
      char dbg[144];

      snprintf(
        dbg,
        sizeof(dbg),
        "NET: Configured Wi-Fi connected; IP %u.%u.%u.%u; fallback AP remains available",
        ip[0], ip[1], ip[2], ip[3]
      );
      setDebugMessage(dbg);
    } else {
      if (previousStaStatus == WL_CONNECTED) {
        setDebugMessage(
          "NET: Configured Wi-Fi connection lost; fallback AP remains available"
        );
      }

      logWiFiStatus("NET: Station status", currentStatus);
    }

    previousStaStatus = currentStatus;
  }

  if (currentStatus == WL_CONNECTED) {
    // Back on the configured network. Start from the short interval again if
    // it is ever lost.
    wifiRetryIntervalMs = WIFI_RETRY_INTERVAL_MS;
    wifiRetryPaused = false;
    return;
  }

  // The AP and the station share one radio and one channel, and the station
  // is the one that picks it. Reconnecting means a scan and an association,
  // which stalls AP traffic for a second or two and can throw AP clients off
  // altogether -- it was cutting the video and swallowing motor commands
  // every 30 seconds. Someone driving the robot over the fallback AP is
  // exactly who should not be interrupted to go looking for another network.
  if (WiFi.softAPgetStationNum() > 0) {
    if (!wifiRetryPaused) {
      wifiRetryPaused = true;
      setDebugMessage(
        "NET: Wi-Fi retry paused while the fallback AP is in use"
      );
    }

    // Hold the deadline open, or the retry fires the instant the last client
    // leaves rather than after a full interval.
    lastWiFiRetryMs = millis();
    return;
  }

  if (wifiRetryPaused) {
    wifiRetryPaused = false;

    // Start from the short interval again. Someone who disconnects from the
    // fallback AP to let the robot rejoin the normal network should not have
    // to wait out a five-minute backoff earned before they arrived.
    wifiRetryIntervalMs = WIFI_RETRY_INTERVAL_MS;

    setDebugMessage("NET: Fallback AP idle; resuming Wi-Fi retries");
  }

  // Periodically retry the configured Wi-Fi while preserving the AP.
  if (millis() - lastWiFiRetryMs >= wifiRetryIntervalMs) {
    lastWiFiRetryMs = millis();

    wifiRetryIntervalMs *= 2;
    if (wifiRetryIntervalMs > WIFI_RETRY_MAX_INTERVAL_MS) {
      wifiRetryIntervalMs = WIFI_RETRY_MAX_INTERVAL_MS;
    }

    char dbg[160];
    snprintf(
      dbg,
      sizeof(dbg),
      "NET: Retrying configured Wi-Fi; previous status: %s; next in %lus",
      wifiStatusName(currentStatus),
      (unsigned long)(wifiRetryIntervalMs / 1000)
    );
    setDebugMessage(dbg);

    WiFi.reconnect();
  }
}

