    }

    .settings-section > summary::-webkit-details-marker {
      display: none;
    }

    .settings-section > summary::after {
      content: "▾";
      color: #667085;
      font-size: 12px;
      transition: transform 0.18s ease;
    }

    .settings-section[open] > summary {
      margin-bottom: 12px;
    }

    .settings-section[open] > summary::after {
      transform: rotate(180deg);
    }

    .setting-row {
      margin-top: 12px;
    }

    .setting-row:first-of-type {
      margin-top: 0;
    }

    .setting-head {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 5px;
      font-size: 13px;
      font-weight: 700;
    }

    .setting-value {
      font-family: monospace;
      color: #475569;
    }

    .camera-select,
    .camera-range {
      width: 100%;
    }

    .camera-select {
      min-height: 42px;
      border: 1px solid #cbd5e1;
      border-radius: 9px;
      background: white;
      padding: 7px 9px;
      color: #172033;
      font-size: 16px;
    }

    .camera-check {
      display: flex;
      align-items: center;
      gap: 9px;
      min-height: 40px;
      font-weight: 700;
      cursor: pointer;
    }

    .camera-check input {
      width: 20px;
      height: 20px;
    }

    .settings-action {
      width: 100%;
      min-height: 42px;
      margin-top: 12px;
      border: 1px solid #94a3b8;
      border-radius: 9px;
      background: #f8fafc;
      color: #172033;
      font-weight: 700;
      cursor: pointer;
    }

    .camera-status {
      margin-top: 10px;
      min-height: 42px;
      padding: 9px 10px;
      border-radius: 9px;
      background: #eef2f7;
      color: #475569;
      font-family: monospace;
      font-size: 12px;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .serial-web-status {
      margin-bottom: 10px;
      padding: 9px 10px;
      border-radius: 9px;
      background: #eef2f7;
      color: #475569;
      font-size: 12px;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .serial-web-status.ok {
      background: #dcfce7;
      color: #14532d;
    }

    .serial-web-status.error {
      background: #fee2e2;
      color: #7f1d1d;
    }

    .serial-toolbar {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 7px;
    }

    .serial-inline-button {
      margin-top: 0;
    }

    .serial-port-info {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-top: 10px;
      padding: 8px 10px;
      border-radius: 9px;
      background: #eef2f7;
      font-size: 12px;
    }

    .serial-port-info span {
      color: #64748b;
    }

    .serial-port-info strong {
      max-width: 65%;
      font-family: monospace;
      text-align: right;
      overflow-wrap: anywhere;
    }

    .serial-capture-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
    }

    .serial-autoscroll {
      margin-right: auto;
      min-height: 34px;
      font-size: 12px;
    }

    .serial-terminal {
      width: 100%;
      height: 230px;
      margin: 9px 0 0;
      padding: 10px;
      overflow: auto;
      border-radius: 10px;
      background: #070d18;
      color: #d1fae5;
      font-family: Consolas, "Courier New", monospace;
      font-size: 12px;
      line-height: 1.45;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .serial-send-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 7px;
      margin-top: 8px;
    }

    .serial-send-button {
      width: auto;
      min-width: 70px;
      margin-top: 0;
    }

    .serial-info {
      margin: 12px 0 0;
      padding-left: 19px;
      color: #475569;
      font-size: 13px;
      line-height: 1.55;
    }

    .serial-commands {
      margin-top: 10px;
      padding: 9px 10px;
      border-radius: 9px;
      background: #111827;
      color: #e5e7eb;
      font-family: monospace;
      font-size: 12px;
      line-height: 1.5;
    }


    .debug-sidebar {
      position: fixed;
      top: 0;
      right: 0;
      z-index: 1050;
      width: min(340px, 88vw);
      height: 100vh;
      padding: 72px 16px 18px;
      background: #111827;
      color: #f9fafb;
      box-shadow: -8px 0 24px rgba(0,0,0,0.22);
      transform: translateX(100%);
      transition: transform 0.22s ease;
      overflow-y: auto;
      text-align: left;
    }

    .debug-sidebar.open {
      transform: translateX(0);
    }

    .debug-sidebar h2 {
      margin: 0 0 14px;
      font-size: 21px;
    }

    .debug-grid {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 8px 14px;
      padding: 12px;
      border-radius: 12px;
      background: #1f2937;
      font-size: 14px;
    }

    .debug-grid .label { color: #cbd5e1; }
    .debug-grid .value { font-family: monospace; font-weight: 700; }

    .debug-message {
      margin-top: 12px;
      padding: 12px;
      border-radius: 12px;
      background: #0b1220;
      font-family: monospace;
      font-size: 13px;
      line-height: 1.45;
      min-height: 70px;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .debug-small {
      margin-top: 10px;
      color: #94a3b8;
      font-size: 12px;
      line-height: 1.4;
    }

    .debug-status-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-top: 12px;
    }

    .debug-connection {
      display: inline-flex;
      align-items: center;
      min-height: 30px;
      padding: 5px 10px;
      border-radius: 999px;
      background: #374151;
      color: #e5e7eb;
      font-size: 12px;
      font-weight: 700;
    }

    .debug-connection.live {
      background: #14532d;
      color: #dcfce7;
    }

    .debug-connection.error {
      background: #7f1d1d;
      color: #fee2e2;
    }

    .debug-log-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 6px;
    }

    .debug-clear {
      min-height: 34px;
      padding: 5px 10px;
      border: 1px solid #475569;
      border-radius: 8px;
      background: #1f2937;
      color: #f8fafc;
      cursor: pointer;
    }

    /* The OTA card lives inside a settings-section, which already draws the
       white card and its border. */
    .ota-panel {
      padding: 0;
    }

    .ota-build {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
      font-size: 13px;
    }

    .ota-build span {
      color: #667085;
    }

    .ota-label,
    .ota-file-label {
      display: block;
      margin: 9px 0 5px;
      color: #475569;
      font-size: 12px;
      font-weight: 700;
    }

    .ota-input,
    .ota-file {
      width: 100%;
      min-height: 40px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      background: white;
      color: #172033;
      padding: 8px 9px;
      font-size: 16px;
    }

    .ota-file {
      padding: 7px;
      font-size: 13px;
    }

    .ota-upload {
      width: 100%;
      min-height: 42px;
      margin-top: 10px;
      border: 0;
      border-radius: 9px;
      background: #334155;
      color: #f8fafc;
      font-weight: 700;
      cursor: pointer;
    }

    .ota-upload:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .ota-progress-shell {
      width: 100%;
      height: 10px;
      margin-top: 10px;
      overflow: hidden;
      border-radius: 999px;
      background: #e2e8f0;
    }

    .ota-progress-bar {
      width: 0%;
      height: 100%;
      background: #334155;
      transition: width 0.12s linear;
    }

    .ota-progress-text {
      margin-top: 7px;
      color: #475569;
      font-family: monospace;
      font-size: 12px;
      overflow-wrap: anywhere;
    }

    .ota-warning {
      margin-top: 9px;
      color: #b45309;
      font-size: 11px;
      line-height: 1.4;
    }

    .debug-log-title {
      margin-top: 14px;
      margin-bottom: 6px;
      color: #cbd5e1;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .debug-log {
      min-height: 110px;
      max-height: 230px;
      overflow-y: auto;
      padding: 10px;
      border-radius: 12px;
      background: #070d18;
      color: #d1d5db;
      font-family: monospace;
      font-size: 12px;
      line-height: 1.45;
    }

    .debug-log-entry {
      padding: 3px 0;
      border-bottom: 1px solid #172033;
      overflow-wrap: anywhere;
    }

    .debug-log-entry:last-child {
      border-bottom: 0;
    }

    @media (max-width: 420px) {
      .button-container {
        grid-template-columns: repeat(3, 76px);
      }

      .button, .led-button {
        width: 76px;
        height: 56px;
      }
    }
  </style>
</head>

